{
  "extends": [
    "github>capralifecycle/renovate-config:default"
  ],
  "automerge": true,
  "automergeType": "branch",
  "packageRules": [
    {
      "matchPackageNames": [
        "org.apache.maven.plugins:maven-surefire-plugin"
      ],
      "allowedVersions": "!/3.6.0/"
    },
    {
      "matchPackageNames": [
        "org.apache.maven.plugins:maven-shade-plugin"
      ],
      "allowedVersions": "3.2.4"
    }
  ]
}
